{
  "expo": {
    "name": "GlowUp AI",
    "slug": "glop-ai",
    "scheme": "glowupai",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0a0d0c",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0a0d0c"
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "GlowUp AI accède à tes photos pour analyser tes repas",
          "cameraPermission": "GlowUp AI utilise l'appareil photo pour analyser tes repas",
          "microphonePermission": false
        }
      ]
    ],
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "GlowUp AI utilise l'appareil photo pour analyser tes repas",
        "NSPhotoLibraryUsageDescription": "GlowUp AI accède à tes photos pour analyser tes repas"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0a0d0c"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "output": "single"
    }
  }
}
